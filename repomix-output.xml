    extractedComputation + '\n  return (\n    <>\n      <div className="flex-1 flex flex-col gap-6">\n'
  );
  
  code = code.replace(
    computationBlock,
    '{computedLines.map(({ line, lineIdx, rng, actualTotalWin, mathIdRng }) => {\n'
  );
